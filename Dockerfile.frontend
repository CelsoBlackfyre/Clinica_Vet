# Development Dockerfile for Vite React frontend
FROM node:25-alpine

WORKDIR /app

RUN npm install -g npm@latest

# Copy package files first
COPY package*.json ./

# Install dependencies from the lockfile for reproducible container builds
RUN npm ci

# Copy the rest of the app (overridden by volume in docker-compose)
COPY . .

EXPOSE 5173

# Run Vite dev server with host binding for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
